{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "dist-lib/types",
    "allowImportingTsExtensions": false
  },
  "include": ["src/ui", "src/growth", "src/hooks", "src/i18n", "src/vite-env.d.ts"],
  "exclude": ["src/ui/**/__tests__", "src/growth/**/__tests__"]
}
