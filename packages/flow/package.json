{
  "name": "@flow/design-system",
  "version": "0.1.0",
  "description": "Flow Design System — umbrella package. Re-exports every layer + the aggregated stylesheet.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./css/styles.css",
    "./fonts": "./css/fonts.css"
  },
  "files": [
    "dist",
    "css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alohasoyrico-eng/Design-system-multiplataforma-desde-cero.git",
    "directory": "packages/flow"
  },
  "homepage": "https://github.com/alohasoyrico-eng/Design-system-multiplataforma-desde-cero#readme",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@flow/tokens": "^0.1.0",
    "@flow/primitives": "^0.1.0",
    "@flow/components": "^0.1.0",
    "@flow/patterns": "^0.1.0",
    "@flow/templates": "^0.1.0",
    "@fontsource/sora": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/archivo": "^5.1.0",
    "material-symbols": "^0.28.0"
  }
}
