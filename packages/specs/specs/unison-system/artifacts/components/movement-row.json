            "behavior": "Risk is communicated through copy and state.",
            "example": "Movement Row",
            "test": "tone audit",
            "rejectIf": "Tone is decorative only."
          },
          "Growth": {
            "status": "covered",
            "decision": "Escalate grouping, actions, detail, or orchestration to patterns.",
            "tokens": [
              "comp.movement-row.*",
              "sys.growth.*"
