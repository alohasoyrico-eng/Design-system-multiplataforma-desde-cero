            "behavior": "Symbols align with text and target size.",
            "example": "receipt_long",
            "test": "iconography audit",
            "rejectIf": "Custom mismatched icons."
          },
          "Accessibility": {
            "status": "covered",
            "decision": "Expose label, status, focus, keyboard behavior, and non-color state.",
            "tokens": [
              "comp.movement-row.*",
              "sys.accessibility.*"
            ],
            "behavior": "Assistive technology can operate or understand the component.",
            "example": "Movement Row",
            "test": "accessibility audit",
            "rejectIf": "Pointer-only or color-only behavior."
          }
        },
        "primitiveDependencies": [
