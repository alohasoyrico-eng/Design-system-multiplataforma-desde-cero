          },
          {
            "id": "declined",
            "description": "Rejected movement row with visible error status."
          },
          {
            "id": "compact",
            "description": "Dense row for sheets and narrow lists."
          }
        ],
        "states": [
          "default",
          "hover",
          "focus",
          "pending",
          "error",
          "disabled"
