            "tokens": [
              "sys.frame.*",
              "comp.movement-row.*"
            ]
          },
          {
            "part": "Icon",
            "rule": "Communicates movement category.",
            "tokens": [
              "sys.symbol.*"
            ]
          },
          {
            "part": "Primary text",
            "rule": "Merchant or movement title.",
            "tokens": [
              "sys.voice.*"
            ]
          },
          {
            "part": "Metadata",
            "rule": "Date, station, vehicle, or card context.",
            "tokens": [
              "sys.growth.*"
            ]
          },
          {
            "part": "Amount and status",
            "rule": "Shows value and approval state with text.",
            "tokens": [
              "sys.state.*"
            ]
          }
        ],
        "variants": [
          {
            "id": "standard",
            "description": "Movement row with category icon, merchant/context, amount, and status."
          },
          {
            "id": "refund",
