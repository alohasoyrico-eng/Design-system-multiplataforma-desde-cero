            "context": "Admin console",
            "example": "Movement Row"
          }
        ],
        "guidelines": {
          "do": [
            "Use for one movement record.",
            "Keep amount and status visible.",
            "Use metadata for source and context."
          ],
          "dont": [
            "Do not include receipt detail inside the row.",
            "Do not make rows depend on color-only status.",
            "Do not group timelines inside the component."
          ],
          "info": [
            "Check long merchant names.",
            "Check amount alignment and tabular numerals.",
            "Check pending and declined states."
          ]
        },
        "contextDensityStrategy": [
          {
            "context": "smartphones + phablets",
            "density": "lg",
            "scaleSource": "Density",
            "layout": "mobile-first readable target"
          },
          {
            "context": "tablets + laptops",
            "density": "md",
            "scaleSource": "Density",
            "layout": "contextual panel or list"
          },
          {
            "context": "desktops + TV",
            "density": "sm",
            "scaleSource": "Density",
            "layout": "dense admin surface"
          }
        ],
        "tests": [
          "Long label wrapping",
          "Amount visibility",
          "Status text visible",
          "Keyboard focus",
          "Pending state",
          "Mobile stacked layout"
        ],
        "agentInstructions": [
          "Use Movement Row for card activity, fuel purchases, refunds, declined movements, and pending transactions.",
          "Keep the row to one record with one amount and one visible status.",
          "Use compact variant in dense mobile sheets when amount remains visible."
        ],
        "rejectIf": [
          "Row contains receipt detail process.",
          "Support, dispute, or export actions live inside the component.",
          "Amount or status disappears on mobile.",
          "Status is color-only."
        ]
