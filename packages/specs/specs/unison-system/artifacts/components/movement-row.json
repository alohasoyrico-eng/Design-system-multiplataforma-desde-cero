            "decision": "Use semantic surface, action, status, and border color.",
            "tokens": [
              "comp.movement-row.*",
              "sys.energy.*"
            ],
            "behavior": "Operational status remains legible without raw colors.",
            "example": "Movement Row",
            "test": "energy audit",
            "rejectIf": "Raw colors or weak contrast."
          },
          "Voice": {
            "status": "covered",
            "decision": "Use concise labels, status, and metadata.",
            "tokens": [
              "comp.movement-row.*",
              "sys.voice.*"
