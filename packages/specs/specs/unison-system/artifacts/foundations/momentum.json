        "maturityTarget": 3,
        "name": "Momentum",
        "purpose": "Govern motion and transition so movement communicates cause, continuity, feedback, priority, and status without becoming required comprehension.",
        "referenceDecision": "Adapt",
        "roles": [
          {
            "id": "instant",
            "token": "sys.momentum.duration.critical",
            "use": "Risk and accessibility fallback changes that must not delay comprehension."
          },
          {
            "id": "fast",
            "token": "sys.momentum.duration.fast",
            "use": "Hover, press, focus, button feedback, small control transitions."
          },
          {
            "id": "default",
            "token": "sys.momentum.duration.default",
            "use": "Tabs, filters, small panels, selected state updates."
          },
          {
            "id": "slow",
            "token": "sys.momentum.duration.slow",
            "use": "Sheets, route transitions, onboarding moments."
          },
          {
            "id": "continuous",
            "token": "sys.state.loading.spin",
            "use": "Loading indicators with reduced-motion alternative."
          },
          {
            "id": "reduced",
            "token": "prefers-reduced-motion",
            "use": "Replace translation/scale with opacity, focus placement, and instant state."
          }
        ],
        "productExamples": [
          {
            "context": "Button loading",
            "example": "Spinner communicates work, but label and aria-busy carry the required information."
          },
          {
            "context": "Routes",
            "example": "Map-to-station transition preserves spatial continuity; fallback list uses instant state update."
          },
          {
            "context": "Bottom sheet",
            "example": "Sheet reveal explains change of context and restores focus after dismissal."
          },
          {
            "context": "Dashboard filters",
            "example": "Chart refresh uses subtle state transition, not decorative movement."
          }
        ],
        "tokenDependencies": [
          "ref.momentum.*",
