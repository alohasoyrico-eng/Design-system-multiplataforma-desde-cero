{
  "components": {
    "checkbox": {
      "api-foundations": {
        "copy": "Checkbox API exposes value, mixed state, support text, validation, and disabled behavior while Design System foundations own styling.",
        "props": [
          { "name": "label", "type": "string", "required": "Yes", "notes": "Visible choice text." },
          { "name": "checked", "type": "boolean", "required": "Yes", "notes": "Selected value." },
          { "name": "indeterminate", "type": "boolean", "required": "No", "notes": "Mixed value for partial selection." },
          { "name": "description", "type": "string", "required": "No", "notes": "Support text under the label." },
          { "name": "error", "type": "string", "required": "No", "notes": "Validation or policy message." },
          { "name": "disabled", "type": "boolean", "required": "No", "notes": "Blocks interaction." },
          { "name": "required", "type": "boolean", "required": "No", "notes": "Marks a required consent or setting." },
          { "name": "onChange", "type": "(checked: boolean) => void", "required": "Yes", "notes": "Reports the next value." }
        ]
      }
    }
  }
}
