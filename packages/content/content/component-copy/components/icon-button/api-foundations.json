{ "components": { "icon-button": { "api-foundations": { "copy": "Icon Button API stays compact: one icon, one accessible action name, one emphasis variant, Density-owned scale, and explicit selected state only when the action is a toggle.", "props": [ { "name": "icon", "type": "string", "required": "yes", "notes": "Approved symbol name." }, { "name": "ariaLabel", "type": "string", "required": "yes", "notes": "Accessible action name." }, { "name": "variant", "type": "'ghost' | 'tonal' | 'primary' | 'accent'", "required": "no", "notes": "Visual emphasis." }, { "name": "density", "type": "'sm' | 'md' | 'lg'", "required": "no", "notes": "Design System Density context for the fixed circular hit area." }, { "name": "selected", "type": "boolean", "required": "no", "notes": "Toggle state exposed as aria-pressed." }, { "name": "badge", "type": "boolean", "required": "no", "notes": "Small status indicator." }, { "name": "disabled", "type": "boolean", "required": "no", "notes": "Blocks action." }, { "name": "onClick", "type": "() => void", "required": "yes", "notes": "Runs the action when enabled." } ] } } } }
