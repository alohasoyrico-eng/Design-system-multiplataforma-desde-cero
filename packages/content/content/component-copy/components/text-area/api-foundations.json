{ "components": { "text-area": { "api-foundations": { "copy": "Text Area API is for multiline free-form text. Rich text, mentions, templates, autosave, and comment threads belong to future patterns.", "props": [ { "name": "label", "type": "string", "required": "yes", "notes": "Visible label." }, { "name": "value", "type": "string", "required": "yes", "notes": "Controlled multiline value." }, { "name": "placeholder", "type": "string", "required": "no", "notes": "Hint, never the only label." }, { "name": "helperText", "type": "string", "required": "no", "notes": "Guidance or recovery copy." }, { "name": "rows", "type": "number", "required": "no", "notes": "Visible row count." }, { "name": "maxLength", "type": "number", "required": "no", "notes": "Shows character counter." }, { "name": "error", "type": "string", "required": "no", "notes": "Validation message." }, { "name": "disabled", "type": "boolean", "required": "no", "notes": "Blocks editing." }, { "name": "onChange", "type": "(value: string) => void", "required": "yes", "notes": "Reports the next value." } ] } } } }
