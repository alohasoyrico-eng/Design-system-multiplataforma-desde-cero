{"components":{"kpi-tile":{"api-foundations":{"copy":"KPI Tile API exposes metric content and state while Design System owns numeral role, tone, surface, and responsive density.","props":[{"name":"label","type":"string","required":"Yes","notes":"KPI label."},{"name":"value","type":"string","required":"Yes","notes":"Primary KPI value."},{"name":"delta","type":"string","required":"No","notes":"Short change indicator."},{"name":"trend","type":"up | down | flat","required":"No","notes":"Delta icon state."},{"name":"tone","type":"neutral | info | success | warning | danger","required":"No","notes":"Semantic threshold tone."},{"name":"icon","type":"IconName","required":"No","notes":"Decorative KPI icon."},{"name":"variant","type":"standard | delta | threshold | sparkline | drill-in","required":"No","notes":"Local anatomy variant."},{"name":"state","type":"default | hover | focus | selected | loading | risk | disabled","required":"No","notes":"Local state."},{"name":"density","type":"sm | md | lg","required":"No","notes":"Density scale."},{"name":"values","type":"number[]","required":"No","notes":"Decorative sparkline values."},{"name":"href","type":"string","required":"No","notes":"Link destination for drill-in."},{"name":"selected","type":"boolean","required":"No","notes":"Selected local state."},{"name":"disabled","type":"boolean","required":"No","notes":"Disables interaction."},{"name":"loading","type":"boolean","required":"No","notes":"Shows loading placeholder."},{"name":"ariaLabel","type":"string","required":"No","notes":"Accessible name override for interactive tiles."},{"name":"onSelect","type":"(metric: KpiTileMeta) => void","required":"No","notes":"Local selection callback for button-style drill-in."}]}}}}
