              "label": "Sync failed.",
              "description": "Last saved data is still available.",
              "tone": "danger",
              "variant": "recovery",
              "icon": "error",
              "actionLabel": "Retry",
              "dismissible": true
            }
          },
          {
            "label": "Undo",
            "demo": {
              "label": "Driver removed.",
              "description": "This can be undone for a short time.",
              "tone": "neutral",
              "variant": "undo",
              "icon": "undo",
              "actionLabel": "Undo",
              "dismissible": true
            }
          }
        ]
      }
    }
  }
