        "copy": "Variant defines the feedback job; state defines lifecycle and available controls. Toast does not block the process or replace inline validation.",
        "states": [
          "visible",
          "action",
          "stacked",
          "exiting",
          "default"
        ],
        "rows": [
          {
            "label": "Status",
            "demo": {
              "label": "Saved changes.",
              "description": "Fleet settings are updated.",
              "tone": "success",
              "variant": "status",
              "icon": "check_circle",
              "dismissible": true
            }
          },
          {
            "label": "Recovery",
