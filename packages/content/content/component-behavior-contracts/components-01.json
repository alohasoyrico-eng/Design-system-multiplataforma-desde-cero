{
  "components": {
    "chip": {
      "model": "controlled",
      "packageOwned": [
        "selected rendering",
        "disabled rendering",
        "removable affordance",
        "accessible pressed state when interactive"
      ],
      "callbacks": [
        "onRemove",
        "onSelectedChange"
      ],
      "focusRules": [
        "Removable chip exposes one predictable focus target until a remove action is explicitly supported."
      ],
      "keyboardRules": [
        "Enter or Space may toggle only when the chip is interactive."
      ],
      "docsOnlyUntilPackaged": [],
      "patternOwned": [
        "filter query composition",
        "bulk filter management"
      ]
    },
    "tabs": {
      "model": "controlled-or-uncontrolled",
      "packageOwned": [
        "selected tab state",
        "roving tabindex",
        "indicator position",
        "disabled tab exclusion"
      ],
      "callbacks": [
        "onValueChange"
      ],
      "focusRules": [
        "Active tab has tabindex 0; inactive tabs have tabindex -1."
      ],
      "keyboardRules": [
        "ArrowLeft",
        "ArrowRight",
        "Home",
        "End"
      ],
      "docsOnlyUntilPackaged": [],
      "patternOwned": [
        "route switching",
        "data loading per tab"
      ]
    },
    "tooltip": {
      "model": "uncontrolled-shell",
      "packageOwned": [
        "hover open",
        "focus open",
        "blur close",
        "Escape close",
        "aria-describedby management"
      ],
      "callbacks": [
        "onOpenChange"
      ],
      "focusRules": [
        "Focus remains on trigger; tooltip content is not tabbable."
      ],
      "keyboardRules": [
        "Escape closes when open."
      ],
      "docsOnlyUntilPackaged": [],
      "patternOwned": [
        "teaching flows",
        "multi-step help"
      ]
    },
    "toast": {
      "model": "controlled-lifecycle",
      "packageOwned": [
