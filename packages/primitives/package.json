{
  "name": "@flow/primitives",
  "version": "0.1.0",
  "description": "Flow L2 primitives — Surface, Text, layout, FlowIcon. Consume system tokens only.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alohasoyrico-eng/Design-system-multiplataforma-desde-cero.git",
    "directory": "packages/primitives"
  },
  "homepage": "https://github.com/alohasoyrico-eng/Design-system-multiplataforma-desde-cero#readme",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@flow/tokens": "^0.1.0"
  }
}
