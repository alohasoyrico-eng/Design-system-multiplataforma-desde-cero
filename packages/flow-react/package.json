{
  "name": "@alohasoyrico-eng/flow-react",
  "version": "0.5.0",
  "type": "module",
  "description": "Flow Design System — componentes React, tokens y patrones multiplataforma",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alohasoyrico-eng/Design-system-multiplataforma-desde-cero.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist-lib/ui/lib-entry.js",
  "module": "./dist-lib/ui/lib-entry.js",
  "types": "./dist-lib/types/ui/lib.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/types/ui/lib.d.ts",
      "import": "./dist-lib/ui/lib-entry.js"
    },
    "./styles.css": "./dist-lib/flow.css",
    "./reset.css": "./dist-lib/reset.css",
    "./fonts/*": "./public/fonts/*",
    "./contracts": "./src/data/items.json",
    "./compat-eone.css": "./dist-lib/compat-eone.css",
    "./specimens": {
      "types": "./dist-lib/types/specimens/index.d.ts",
      "import": "./dist-lib/specimens/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist-lib",
    "public/fonts",
    "src/data/items.json",
    "docs/USUARIO.md"
  ],
  "scripts": {
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && cp src/reset.css dist-lib/reset.css && cp generated/tokens/css/compat-eone.css dist-lib/compat-eone.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:build": "node sd.config.js",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "flag-icons": "^7.5.0",
    "react-intl": "^10.1.23"
  },
  "devDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "style-dictionary": "^4.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
