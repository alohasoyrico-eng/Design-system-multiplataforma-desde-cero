{
  "$comment": "Contrato de capas legible por maquina. Fuente de verdad de check-layers.mjs. Ver 'Arquitectura de capas.dc.html' para el porque y contracts/_schema.json para la forma de cada item.",
  "version": 1,
  "layers": [
    {
      "id": "foundations",
      "order": 0,
      "dependsOn": [],
      "entry": "Decision expresable sin JSX y consumible desde Angular o Flutter.",
      "forbids": [
        "Cualquier archivo .jsx"
      ]
    },
    {
      "id": "primitives",
      "order": 1,
      "dependsOn": [
        "foundations"
      ],
      "sameLayerAllowed": "primitives/shells",
      "entry": "No importa nada del sistema salvo tokens y shells. Hoja del grafo. Duena de una sola carcasa.",
      "forbids": [
        "Importar un component",
        "Conocer el dominio",
        "Posicionarse en la pagina"
      ]
    },
    {
      "id": "components",
      "order": 2,
      "dependsOn": [
        "foundations",
        "primitives"
      ],
      "entry": "Compone primitives y exporta un componente con contrato de props. Su API es generica: el dominio no decide la capa.",
      "forbids": [
        "Redibujar una carcasa que ya existe abajo",
        "Fetch, rutas, copy de producto",
        "Importar un pattern"
      ]
    },
    {
      "id": "patterns",
      "order": 3,
      "dependsOn": [
        "foundations",
        "primitives",
        "components"
      ],
      "entry": "No tiene una sola API: es una receta. Regla de uso mas composicion de referencia, con estado a lo largo de varios pasos o archivos. Si exporta un componente con props, no es pattern.",
      "forbids": [
        "Traer bloque api",
        "Ser una pantalla con contenido final",
        "Ser solo prosa sin implementacion de referencia"
      ]
    },
    {
      "id": "templates",
      "order": 4,
      "dependsOn": [
        "foundations",
        "primitives",
        "components",
        "patterns"
      ],
      "entry": "Nombra una pantalla de producto real y trae contenido final. Se copia, no se importa.",
      "forbids": [
        "Exportarse como libreria",
        "Que alguien lo importe en produccion"
      ]
    }
  ],
  "rules": {
    "R1": {
      "name": "Las dependencias solo van hacia abajo",
      "severity": "block",
      "note": "Una dependencia externa (ECharts, tiles) no cuenta: R1 solo mira el grafo del sistema. Misma capa solo se permite si uno de los dos lados es un shell: la carpeta primitives/shells/ esta por debajo de primitives, asi que DataGrid puede componer Checkbox y Select puede componer Listbox."
    },
    "R2": {
      "name": "Una variante no es un item",
      "severity": "block",
      "note": "Un item = un archivo. Nada en supersedes puede tener archivo, entrada de registry, ni mencion en texto de otro item."
    },
    "R3": {
      "name": "Una carcasa, un dueno",
      "severity": "block",
      "note": "Fuera de los shells, ningun archivo declara borde+foco+radio de control, backdrop fijo, ni @keyframes propios. Los keyframes del sistema viven en tokens/motion.css, que es foundations (mot-5). Las dos ultimas carcasas propias se resolvieron componiendo: BulkActionsTable pasa sus acciones a Button y su cerrar a IconButton; FilterableEditableTable pasa sus filtros a Input, que compone ControlShell. El ratchet llego a cero, asi que R3 pasa de warn-ratchet a block.",
      "knownOffenders": {
        "controlCarcass": []
      }
    },
    "R4": {
      "name": "La composicion no se filtra a la API",
      "severity": "block",
      "note": "Ningun nombre declarado en composition puede aparecer como miembro de api."
    },
    "P6": {
      "name": "La capa declarada coincide con la recomputada",
      "severity": "block",
      "note": "La capa se deriva del artefacto: exporta componente con api = component; sin api = pattern; hoja del grafo = primitive. Un criterio que el chequeo no puede recomputar no se puede sostener."
    },
    "R5": {
      "name": "Todo item tiene contrato y el contrato valida",
      "severity": "block",
      "note": "La reja final: platforms/check-contracts.mjs comprueba que cada item de architecture.json apunta a un contrato existente, que la capa del contrato coincide con la del item, y que el contrato cumple el allOf de _schema.json, que NO es uniforme entre capas. Tambien recomputa R4 desde el propio contrato: ninguna prop publica repite un nombre de composition. Cobertura como ratchet: puede subir, nunca bajar."
    }
  },
  "shells": [
    "control-shell",
    "data-grid",
    "listbox",
    "overlay-shell",
    "popover",
    "toggle-control"
  ],
  "fileLayers": {
