{
  "name": "flow-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Flow — design system multiplataforma (foundations > primitives > components > patterns > templates)",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tokens:build": "npm run build --workspace @flow/tokens",
    "mailings:build": "npm run build --workspace @flow/mailings",
    "build": "turbo run build",
    "dev": "turbo run build --watch",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "lint:css": "stylelint \"packages/**/css/**/*.css\"",
    "audit:hardcoded": "node scripts/audit-hardcoded.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "verify": "npm run tokens:build && npm run lint && npm run lint:css && npm run audit:hardcoded && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "style-dictionary": "^4.3.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
