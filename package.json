{
  "name": "flow-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/flow-react",
    "apps/banco"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/banco --",
    "build": "npm run build -w apps/banco",
    "build:lib": "npm run build:lib -w packages/flow-react",
    "preview": "npm run preview -w apps/banco --",
    "lint": "oxlint",
    "typecheck": "npm run typecheck -w packages/flow-react && npm run typecheck -w apps/banco",
    "test": "npm run test -w packages/flow-react && npm run test -w apps/banco",
    "tokens:build": "npm run tokens:build -w packages/flow-react",
    "sync:docs": "node scripts/sync-docs.mjs",
    "sync:docs:check": "node scripts/sync-docs.mjs --check",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:inventory": "node scripts/check-inventory-sync.mjs",
    "check:foundations": "node scripts/check-foundations.mjs",
    "check:targets": "node scripts/check-targets.mjs",
    "check:color": "node scripts/check-color.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:api-drift": "node scripts/check-api-drift.mjs",
    "check:conformance": "node scripts/check-conformance-coverage.mjs --min 415",
    "check:tokens-parity": "node scripts/check-tokens-parity.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.75.0"
  }
}
