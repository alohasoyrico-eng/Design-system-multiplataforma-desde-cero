{
  "id": "nip-reveal",
  "name": "NipReveal",
  "layer": "patterns",
  "function": [
    "display"
  ],
  "status": "stable",
  "summary": "Revelado temporal de NIP/PIN con blur, timeout y advertencia. Patron de seguridad financiera.",
  "conformance": {
    "criteria": [
      {
        "id": "nr-1",
        "rule": "Se oculta automaticamente despues del timeout.",
        "level": "must",
        "verify": "automated"
      },
      {
        "id": "nr-2",
        "rule": "Con blurLast el ultimo digito se desenfoca para proteccion parcial.",
        "level": "should",
        "verify": "visual"
      },
      {
        "id": "nr-3",
        "rule": "El NIP no vive en el DOM hasta revelarse, y el boton de mostrar tiene nombre accesible.",
        "level": "must",
        "verify": "automated"
      }
    ]
  },
  "implements": [
    "button"
  ],
  "domain": "fintech",
  "nonGoals": [
    "No valida el NIP: solo lo muestra temporalmente."
  ],
  "platforms": {
    "web": "adopted"
  },
  "reference": {
    "src": "patterns/NipReveal.tsx"
  },
  "api": {
    "members": [
      {
        "name": "digits",
        "kind": "prop",
        "type": "string",
        "required": true
      },
      {
        "name": "blurLast",
        "kind": "prop",
        "type": "boolean"
      },
      {
        "name": "duration",
        "kind": "prop",
        "type": "number"
      },
      {
        "name": "warning",
        "kind": "prop",
        "type": "string"
      }
    ]
  }
}
