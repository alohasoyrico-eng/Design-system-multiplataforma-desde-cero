{
  "id": "wizard",
  "name": "Wizard",
  "layer": "components",
  "status": "stable",
  "summary": "Marco del formulario multi-paso: Stepper arriba, un paso por cuerpo y botonera Volver / Siguiente / Confirmar con estado de carga. WizardSummary, WizardSummarySection y WizardSummaryRow arman el resumen editable del paso final.",
  "api": {
    "members": [
      {
        "name": "steps",
        "kind": "prop",
        "type": "StepperStep[]",
        "required": true
      },
      {
        "name": "current",
        "kind": "prop",
        "type": "number",
        "required": true
      },
      {
        "name": "onBack",
        "kind": "event",
        "type": "() => void"
      },
      {
        "name": "onNext",
        "kind": "event",
        "type": "() => void"
      },
      {
        "name": "onSubmit",
        "kind": "event",
        "type": "() => void"
      },
      {
        "name": "submitting",
        "kind": "prop",
        "type": "boolean",
        "default": "false"
      },
      {
        "name": "nextLabel",
        "kind": "prop",
        "type": "string",
        "default": "i18n common.next"
      },
      {
        "name": "submitLabel",
        "kind": "prop",
        "type": "string",
        "default": "i18n common.confirm"
      },
      {
        "name": "children",
        "kind": "slot",
        "type": "ReactNode",
        "required": true
      }
    ]
  },
  "conformance": {
    "inherits": [
      "_base"
    ],
    "criteria": [
      {
        "id": "wz-1",
        "rule": "En el ultimo paso la accion primaria es confirmar; en los demas, siguiente. Nunca ambas.",
        "level": "must",
        "verify": "automated"
      },
      {
        "id": "wz-2",
        "rule": "Con submitting activo el boton de confirmar muestra carga y volver queda deshabilitado.",
        "level": "must",
        "verify": "automated"
      },
      {
        "id": "wz-3",
        "rule": "Volver un paso no destruye lo capturado: el estado vive en el contenedor, no en el Wizard.",
        "level": "must",
        "verify": "manual"
      },
      {
        "id": "wz-4",
        "rule": "Los labels de siguiente/confirmar salen de i18n (common.next / common.confirm) y aceptan override por prop.",
        "level": "should",
        "verify": "automated"
      }
    ]
  },
  "composition": {
    "primitives": [
      "stepper",
      "button"
    ]
  },
  "nonGoals": [
    "No valida pasos: la validacion es del formulario contenedor.",
    "No persiste estado: eso es del pattern wizard-pattern."
  ],
  "reference": {
    "src": "components/Wizard.tsx"
  }
}
