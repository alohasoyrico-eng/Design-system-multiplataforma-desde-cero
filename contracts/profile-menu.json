        "required": true
      },
      {
        "name": "avatarName",
        "kind": "prop",
        "type": "string",
        "required": true
      },
      {
        "name": "role",
        "kind": "prop",
        "type": "string",
        "required": true
      },
      {
        "name": "badge",
        "kind": "prop",
