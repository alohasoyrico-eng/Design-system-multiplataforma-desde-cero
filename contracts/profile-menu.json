{
  "id": "profile-menu",
  "name": "ProfileMenu",
  "layer": "patterns",
  "function": [
    "navigation"
  ],
  "status": "stable",
  "summary": "Menu de perfil con avatar, nombre, rol y lista de acciones con iconos.",
  "conformance": {
    "criteria": [
      {
        "id": "pm-1",
        "rule": "Cada item de accion tiene hit target >= 44px.",
