        "rule": "Los tonos de before/after salen de los tokens --status-*, jamas de un hex a mano.",
        "level": "must",
        "verify": "automated"
      }
    ]
  },
  "implements": [
    "card"
  ],
  "nonGoals": [
    "No maneja estado de aprobacion: eso es logica de negocio."
  ],
