{
  "id": "stattile",
  "name": "StatTile",
  "layer": "components",
  "function": [
    "dataviz"
  ],
  "status": "stable",
  "summary": "Una cifra que importa, con su variacion y su tendencia. El componente mas usado del sistema.",
  "api": {
    "members": [
      {
        "name": "label",
        "kind": "prop",
        "type": "string",
        "required": true
      },
      {
        "name": "value",
        "kind": "prop",
        "type": "string | number",
        "required": true
      },
      {
        "name": "delta",
        "kind": "prop",
        "type": "string",
        "note": "Variacion con signo."
      },
      {
        "name": "trend",
        "kind": "prop",
        "type": "number[]",
        "note": "Serie para la Sparkline."
      },
      {
        "name": "icon",
        "kind": "prop",
        "type": "string"
      },
      {
        "name": "tone",
        "kind": "prop",
        "type": "'neutral' | 'success' | 'warning' | 'danger'"
      },
      {
        "name": "style",
        "kind": "prop",
        "type": "React.CSSProperties"
      }
    ]
  },
  "conformance": {
    "criteria": [
      {
        "id": "stt-1",
        "rule": "La cifra va en la familia de dato y es lo mas grande de la tarjeta: si la etiqueta compite con el numero, el KPI no se lee de un vistazo.",
        "level": "must",
        "verify": "visual"
      },
      {
        "id": "stt-2",
        "rule": "El signo del delta se dice con texto o icono, no solo con verde o rojo.",
        "level": "must",
        "verify": "automated"
      },
      {
        "id": "stt-3",
        "rule": "La Sparkline esta oculta al lector: la cifra ya la dice el valor y el delta.",
        "level": "must",
        "verify": "automated"
      },
      {
        "id": "stt-4",
        "rule": "Sin delta ni trend la tarjeta no deja huecos: el alto lo fija el contenido que hay.",
        "level": "must",
        "verify": "visual"
      },
      {
        "id": "stt-5",
        "rule": "El delta dice contra que compara, en el propio texto: '+4 vs ayer', no '+4'.",
        "level": "must",
        "verify": "visual"
      }
    ]
  },
  "tokens": [
    "--type-data-lg",
    "--text-muted",
    "--status-success-text",
    "--status-danger-text",
    "--surface-card"
  ],
  "nonGoals": [
    "No es una grafica: la tendencia es un apoyo de 88px, no el dato.",
    "No enlaza a ningun sitio por su cuenta."
  ],
  "reference": {
    "src": "components/StatTile.jsx",
    "states": "docs/cards/dataviz.card.html"
  },
  "platforms": {
    "web": "reference",
    "angular": "reference",
    "flutter": "reference"
  }
}
