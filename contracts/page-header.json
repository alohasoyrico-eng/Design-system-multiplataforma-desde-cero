        "kind": "prop",
        "type": "string"
      },
      {
        "name": "description",
        "kind": "prop",
        "type": "string"
      },
      {
        "name": "breadcrumb",
        "kind": "prop",
        "type": "string[]"
      },
      {
        "name": "filters",
        "kind": "prop",
