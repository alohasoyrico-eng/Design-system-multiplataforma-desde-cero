{
  "id": "page-header",
  "name": "PageHeader",
  "layer": "patterns",
  "function": [
    "navigation"
  ],
  "status": "stable",
  "summary": "Header de pagina con titulo, breadcrumb, filtros, acciones y boton de menu responsive.",
  "conformance": {
    "criteria": [
      {
        "id": "ph-1",
        "rule": "El breadcrumb no se trunca en desktop: se trunca en movil.",
        "level": "should",
        "verify": "visual"
      },
      {
        "id": "ph-2",
        "rule": "El titulo es un h1 real y el boton de menu movil tiene nombre accesible.",
        "level": "must",
        "verify": "automated"
      }
    ]
  },
  "nonGoals": [
    "No incluye busqueda: para eso usar GlobalSearch en TopBar."
  ],
  "platforms": {
    "web": "adopted"
  },
  "reference": {
    "src": "patterns/PageHeader.tsx"
