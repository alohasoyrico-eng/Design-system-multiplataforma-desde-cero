{
  "id": "limit-bar",
  "name": "LimitBar",
  "layer": "components",
  "function": [
    "display"
  ],
  "status": "stable",
  "summary": "Barra de progreso con label y valores current/max. Para limites de gasto o cuotas.",
  "api": {
    "members": [
      {
        "name": "label",
        "kind": "prop",
        "type": "string",
        "required": true
      },
      {
        "name": "current",
        "kind": "prop",
        "type": "number",
        "required": true
      },
      {
        "name": "max",
        "kind": "prop",
        "type": "number",
        "required": true
      },
      {
        "name": "style",
        "kind": "prop",
        "type": "React.CSSProperties"
      }
    ]
  },
  "conformance": {
    "criteria": [
      {
        "id": "lb-1",
        "rule": "Los valores se muestran con formato de moneda (localeString).",
        "level": "must",
        "verify": "automated"
      },
      {
        "id": "lb-2",
        "rule": "Con max=0 no produce division por cero: muestra barra vacia.",
        "level": "must",
        "verify": "automated"
      }
    ]
  },
  "tokens": [
    "--surface-sunken",
    "--status-success",
    "--font-mono",
    "--radius-pill"
  ],
  "nonGoals": [
    "No tiene variantes de color por porcentaje (rojo al llegar al limite). Eso seria un enhancement."
  ],
  "platforms": {
    "web": "adopted"
  },
  "reference": {
    "src": "components/LimitBar.tsx"
  }
}
