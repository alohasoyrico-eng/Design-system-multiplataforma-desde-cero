{
  "id": "peek-sheet",
  "name": "PeekSheet",
  "layer": "components",
  "function": [
    "feedback"
  ],
  "status": "stable",
  "summary": "Sheet inferior parcial con handle, titulo y lista. Vista previa de contenido sin cubrir toda la pantalla.",
  "api": {
    "members": [
      {
        "name": "title",
        "kind": "prop",
        "type": "string",
        "required": true
      },
      {
        "name": "children",
        "kind": "slot",
        "type": "React.ReactNode",
        "required": true
      },
      {
        "name": "style",
        "kind": "prop",
        "type": "React.CSSProperties"
      }
    ]
  },
  "conformance": {
    "criteria": [
      {
        "id": "ps-1",
        "rule": "El handle es visible y comunica que el sheet es arrastrable.",
        "level": "must",
        "verify": "visual"
      }
    ]
  },
  "tokens": [
    "--surface-card",
    "--radius-xl",
    "--shadow-float",
    "--text-primary"
  ],
  "nonGoals": [
    "No tiene drag-to-dismiss: es un peek estatico. Para sheets interactivos usar BottomSheet."
  ],
  "platforms": {
    "web": "adopted"
  },
  "reference": {
    "src": "components/PeekSheet.tsx"
  }
}
