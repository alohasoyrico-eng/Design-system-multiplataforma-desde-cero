{
  "id": "status-view",
  "name": "StatusView",
  "layer": "components",
  "function": [
    "feedback"
  ],
  "status": "stable",
  "summary": "Pantalla de estado al conectar con un servicio: cargando, exito, error o sin conexion, con la accion que sigue.",
  "api": {
    "members": [
      {
        "name": "status",
        "kind": "prop",
        "type": "'loading' | 'success' | 'error' | 'offline'",
        "default": "loading",
        "variantAxis": true
      },
      {
        "name": "title",
        "kind": "prop",
        "type": "string"
      },
      {
        "name": "description",
        "kind": "prop",
        "type": "string"
      },
      {
        "name": "primaryAction",
        "kind": "slot",
        "type": "React.ReactNode"
      },
      {
        "name": "secondaryAction",
        "kind": "slot",
        "type": "React.ReactNode"
      },
      {
        "name": "fullScreen",
        "kind": "prop",
        "type": "boolean",
        "default": false
      },
      {
        "name": "style",
        "kind": "prop",
        "type": "React.CSSProperties"
      }
    ]
  },
  "conformance": {
    "criteria": [
      {
        "id": "stv-1",
        "rule": "El cambio de estado se anuncia: loading con aria-busy, error y offline con role=alert. Una pantalla que cambia en silencio deja al usuario esperando.",
        "level": "must",
        "verify": "automated"
      },
      {
        "id": "stv-2",
        "rule": "El error dice que hacer, no solo que fallo: sin accion primaria es un callejon.",
        "level": "must",
        "verify": "visual"
      },
      {
        "id": "stv-3",
        "rule": "offline se distingue de error: uno se resuelve reintentando, el otro no.",
        "level": "must",
        "verify": "visual"
      },
      {
        "id": "stv-4",
        "rule": "Con prefers-reduced-motion el estado de exito aparece sin resorte.",
        "level": "must",
        "verify": "automated"
      },
      {
        "id": "stv-5",
        "rule": "Con fullScreen sigue permitiendo salir: nunca es una pantalla sin salida.",
        "level": "must",
        "verify": "manual"
      }
    ]
  },
  "tokens": [
    "--status-success",
    "--status-danger",
    "--text-muted",
    "--surface-canvas",
    "--ease-spring"
  ],
  "nonGoals": [
    "No es EmptyState: aqui algo paso, no es que no haya nada.",
    "No reintenta por su cuenta."
  ],
  "reference": {
    "src": "components/StatusView.jsx",
    "demo": "docs/demos/status-view.html"
  },
  "platforms": {
    "web": "reference",
    "angular": "reference",
    "flutter": "reference"
  }
}
