        "verify": "visual"
      },
      {
        "id": "gc-2",
        "rule": "La franja y el texto del tono salen de los tokens --status-*, jamas de un hex a mano.",
        "level": "must",
        "verify": "automated"
      }
    ]
  },
  "implements": [
    "card",
    "specimen"
  ],
  "nonGoals": [
    "No tiene estado de aprobacion: es referencia estatica."
  ],
  "platforms": {
    "web": "adopted"
  },
  "reference": {
    "src": "patterns/GuidanceCard.tsx"
  },
  "api": {
    "members": [
      {
        "name": "tone",
        "kind": "prop",
        "type": "'success' | 'danger'",
        "required": true
      },
      {
        "name": "rules",
        "kind": "prop",
        "type": "string[]",
        "required": true
      },
      {
        "name": "specimen",
        "kind": "prop",
        "type": "ReactNode"
      }
    ]
  }
