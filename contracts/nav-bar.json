{
  "id": "nav-bar",
  "name": "NavBar",
  "layer": "components",
  "function": [
    "navigation"
  ],
  "status": "stable",
  "summary": "Barra de navegacion movil con boton back, titulo centrado y trailing slot.",
  "api": {
    "members": [
      {
        "name": "title",
        "kind": "prop",
        "type": "string",
        "required": true
      },
      {
        "name": "onBack",
        "kind": "event",
        "type": "() => void"
      },
      {
        "name": "trailing",
        "kind": "slot",
        "type": "React.ReactNode"
      },
      {
        "name": "style",
        "kind": "prop",
        "type": "React.CSSProperties"
      }
    ]
  },
  "conformance": {
    "criteria": [
      {
        "id": "nb-1",
        "rule": "El boton back tiene hit target >= 44px y aria-label.",
        "level": "must",
        "verify": "automated"
      }
    ]
  },
  "tokens": [
    "--height-bar",
    "--surface-card",
    "--text-primary"
  ],
  "nonGoals": [
    "No tiene variantes de superficie: para top bar con variantes usar TopBar."
  ],
  "platforms": {
    "web": "adopted"
  },
  "reference": {
    "src": "components/NavBar.tsx"
  }
}
